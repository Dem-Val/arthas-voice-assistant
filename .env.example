# ==============================================================================
# НАСТРОЙКИ НЕЙРОСЕТИ ДЛЯ ПОМОЩНИКА «АРТАС»
# ==============================================================================

# Выбор основного провайдера: "openrouter" (без VPN) или "gemini"
AI_PROVIDER=openrouter

# 1. РЕКОМЕНДУЕМЫЙ ВАРИАНТ ДЛЯ РФ (БЕЗ VPN): OpenRouter
# Бесплатный ключ в 1 клик: https://openrouter.ai/keys (начинается на sk-or-...)
# Бесплатные модели: deepseek/deepseek-chat:free или google/gemini-2.0-flash-exp:free
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=deepseek/deepseek-chat:free

# 2. РЕЗЕРВНЫЙ ВАРИАНТ: Google Gemini API (требует VPN в РФ)
# Получить бесплатно: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Прокси для Gemini (если используете):
GEMINI_PROXY=

# ==============================================================================
# НАСТРОЙКИ АССИСТЕНТА
# ==============================================================================
ASSISTANT_NAME=артас

# Озвучка ответов (true - голос Edge-TTS, false - только текст в консоли)
ENABLE_TTS=false

# Настройки голоса
VOICE_NAME=ru-RU-DmitryNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

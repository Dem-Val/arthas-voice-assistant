# Google Gemini API Key (получить бесплатно на https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini
GEMINI_MODEL=gemini-3.5-flash-lite

# ПРОКСИ ДЛЯ GOOGLE GEMINI (если в РФ без VPN):
# GEMINI_PROXY=http://127.0.0.1:10809

# АЛЬТЕРНАТИВА: OpenRouter (работает в РФ без VPN):
# OPENAI_API_KEY=your_openrouter_key_here
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=google/gemini-2.0-flash-exp:free

# Имя помощника для активации
ASSISTANT_NAME=гладиатор

# Голос Edge-TTS (ru-RU-DmitryNeural или ru-RU-SvetlanaNeural)
VOICE_NAME=ru-RU-DmitryNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

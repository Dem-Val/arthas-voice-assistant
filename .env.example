# Google Gemini API Key (получить бесплатно на https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Имя помощника для активации (можно изменить в любой момент)
ASSISTANT_NAME=лина

# Голос Edge-TTS (доступны: ru-RU-SvetlanaNeural, ru-RU-DmitryNeural)
VOICE_NAME=ru-RU-SvetlanaNeural
VOICE_RATE=+0%
VOICE_PITCH=+0Hz

# Модель Gemini (gemini-2.0-flash или gemini-1.5-flash - быстрые и умные)
GEMINI_MODEL=gemini-2.0-flash
